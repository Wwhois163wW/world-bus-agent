{
  "name": "world-bus-agent",
  "version": "0.1.0",
  "description": "Local-first, event-stream IoC agent runtime core with pluggable eyes, hands, and OpenAI-compatible brain.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts --config ./agent.config.json",
    "start": "node dist/cli.js --config ./agent.config.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
